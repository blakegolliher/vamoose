# Build artifacts
/target
**/*.rs.bk

# Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Backup/probe files
*.bak
*.tmp

# Run artifacts (M5 + T4 harnesses, scratch space, ad-hoc logs)
/m5/run/
/t4/run/
/scratch/
*.log

# Local environment / secrets
.env
.env.local

# Sandbox dirs
/tmp/
/private/

# Per-session tool state
.claude/
/dist

# Rendered/site-specific operations state. The example specification and
# harness are tracked; real endpoints, hostnames, and release paths are not.
/ops/run.env
/ops/generated/
/ops/state/
__pycache__/
*.py[cod]
