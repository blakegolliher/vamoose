[Unit]
Description=vamoose coordinator (control plane for the TUI)
Documentation=https://github.com/blakegolliher/vamoose
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Reads [run] and [coord] from /etc/vamoose/vamoose.toml. Only one
# coordinator may run per bucket (S3 lease); enable this on ONE node.
ExecStart=/usr/bin/vamoose coord
EnvironmentFile=-/etc/vamoose/vamoose.env
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vamoose-coord

[Install]
WantedBy=multi-user.target
