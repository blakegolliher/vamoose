# /etc/vamoose/vamoose.env — secrets for the vamoose services.
# Install with: sudo install -m 0600 vamoose.env.example /etc/vamoose/vamoose.env
# Loaded by vamoose-worker@.service and vamoose-coord.service. For interactive
# commands (vamoose prepare / status / tui) run: set -a; . /etc/vamoose/vamoose.env; set +a

# S3 credentials for the coordination bucket in [run].
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Shared worker secret; the same value on every node. Generate one with:
#   openssl rand -hex 32
VAMOOSE_CLUSTER_SECRET=REPLACE_ME
