[Unit]
Description=vamoose migration worker (%i)
Documentation=https://github.com/blakegolliher/vamoose
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# Root is currently required: libnfs binds reserved ports (<1024) for
# AUTH_SYS and preserve_owner needs CAP_CHOWN semantics on the wire.
User=root
# Configuration: /etc/vamoose/workers/%i.toml if it exists, otherwise the
# shared /etc/vamoose/vamoose.toml. One worker per host needs only the
# shared file (`systemctl enable --now vamoose-worker@main`).
Environment=VAMOOSE_INSTANCE=%i
ExecStart=/usr/bin/vamoose worker
EnvironmentFile=-/etc/vamoose/vamoose.env
EnvironmentFile=-/etc/vamoose/workers/%i.env
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=10
# Exit 0 means all shards terminal or an orderly coordinator stop.
SuccessExitStatus=0
KillSignal=SIGTERM
TimeoutStopSec=300
LimitNOFILE=65536
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vamoose-worker-%i

[Install]
WantedBy=multi-user.target
