# Copy to ops/run.env and replace every example value. This is a Bash data
# file sourced by the tracked operations scripts; do not put credentials in it.

# Immutable identity for one migration. Keep it stable from preparation
# through final verification.
RUN_ID="customer-a-20260823t220000z"

# Provenance-checked archive produced by `make bundle`. The adjacent
# `.sha256` file is mandatory.
RELEASE_BUNDLE="/srv/vamoose/releases/vamoose-0.1.0-GIT_SHA-x86_64-unknown-linux-gnu.2.34.tar.gz"

# Preparation is isolated below PREPARE_ROOT/RUN_ID. nfs-walker is an
# external scanner and is therefore pinned here separately from the vamoose
# release bundle. Set the digest from `sha256sum /path/to/nfs-walker`.
PREPARE_ROOT="/srv/vamoose/preparation"
NFS_WALKER_BIN="/opt/nfs-walker/bin/nfs-walker"
NFS_WALKER_SHA256="REPLACE_WITH_64_HEX_SHA256"
NFS_WALKER_SUDO=true

# Scanner output/tuning. An interrupted attempt is preserved; the next
# prepare invocation starts a fresh numbered attempt and never guesses that a
# partial walker directory is complete.
WALKER_WORKERS=32
WALKER_QUEUE_SIZE=10000
WALKER_BATCH_SIZE=5000
WALKER_WRITER_SHARDS=32
WALKER_PIPELINE_DEPTH=8
WALKER_PARQUET_COMPRESSION="zstd3"
WALKER_ROW_GROUP_SIZE=256000
WALKER_FILE_SIZE_MB=512
WALKER_EXCLUDES=(".snapshot")

# Deterministic final verification policy.
VERIFY_SAMPLE_COUNT=2000
VERIFY_SAMPLE_SEED=600
VERIFY_MAX_CONTENT_BYTES=10485760

# Coordination store. AWS_PROFILE names credentials already provisioned on
# each host; deployment never copies or edits credential files.
VAMOOSE_ENDPOINT="https://s3.example.com"
VAMOOSE_BUCKET="vamoose-customer-a-20260823t220000z"
AWS_REGION="us-east-1"
AWS_PROFILE="vamoose"
VERIFY_TLS=true

# Data plane. Roots are paths within their respective NFS exports.
SRC_NFS_URL="nfs://source.example.com/source-export"
DST_NFS_URL="nfs://destination.example.com/destination-export"
SRC_ROOT="/dataset"
DST_ROOT="/dataset-migrated"

# Kernel mounts are used only for guarded reset and verification. RESET_HOST
# and VERIFY_HOST must name SSH hosts present in WORKER_INSTANCES.
SRC_MOUNT="/mnt/source"
DST_MOUNT="/mnt/destination"
RESET_HOST="worker-a.example.com"
VERIFY_HOST="worker-a.example.com"

# Optional coordinator attachment. Leave both empty for S3-only operation.
COORD_URL=""
JOB_ID=""

# Deployment locations. The remote account needs passwordless sudo for the
# installer and service-management steps.
REMOTE_USER="vamoose-admin"
INSTALL_PREFIX="/opt/vamoose"
REMOTE_CONFIG_DIR="/etc/vamoose/workers"
REMOTE_STAGING_DIR="/var/tmp/vamoose-deploy"

# One record per worker process, including multiple processes on one host.
# Fields: ssh_host|instance|host_id|nfs_connections|inflight_small|scratch
# `instance` is the systemd template instance name and must be unique.
WORKER_INSTANCES=(
  "worker-a.example.com|worker-a-1|worker-a-1|110|512|/dev/shm/vamoose-1"
  "worker-a.example.com|worker-a-2|worker-a-2|70|128|/dev/shm/vamoose-2"
  "worker-b.example.com|worker-b-1|worker-b-1|110|512|/dev/shm/vamoose-1"
  "worker-b.example.com|worker-b-2|worker-b-2|70|128|/dev/shm/vamoose-2"
)

# Shared worker tuning. Per-instance values above replace the old practice of
# generating one config and mutating a second one with sed.
HEARTBEAT_SEC=30
LEASE_TIMEOUT_SEC=180
MAX_SHARDS_IN_FLIGHT=1
RPC_TIMEOUT_MS=60000
USE_RAW_FH=true
DIRECT_COMMIT=true
USE_BUCKETED_POOL=false

BYTES_BUDGET="8 GiB"
FILES_BUDGET=20000
INFLIGHT_MEDIUM=16
INFLIGHT_LARGE=4
LARGE_STRIPE_SIZE="4 MiB"
LARGE_STRIPE_DEPTH=32

PRESERVE_OWNER=true
PRESERVE_MODE=true
PRESERVE_TIMES=true
PRESERVE_XATTR=true
REQUIRE_CHOWN_CAPABILITY=true
REQUIRE_UNCHANGED_SIZE=false

FAILURE_PCT_WINDOW_SEC=60
FAILURE_PCT_THRESHOLD=5.0
THROUGHPUT_FLOOR_MB_S=0

# Optional executable hooks for pausing/resuming site-local background work
# that would contend with a timed migration. Hooks receive VAMOOSE_RUN_ENV.
# They must be idempotent. Leave empty when no external work is managed.
PAUSE_HOOK=""
RESUME_HOOK=""
